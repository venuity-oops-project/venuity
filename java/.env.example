# =================================================================
# VENUITY ENVIRONMENT CONFIGURATION
# =================================================================
# For local development, copy this file to .env and adjust if needed.
# For production deployments (e.g. Render, Oracle Cloud, Aiven MySQL),
# set these variables in your hosting provider's dashboard or systemd environment.
# =================================================================

# --- Application Server & Port ---
# PORT is automatically assigned by PaaS providers (e.g. Render, Heroku).
# SERVER_PORT is used as a fallback if PORT is unset.
# PORT=8080
SERVER_PORT=8080

# --- Database Connection (MySQL 8.4+ / Aiven / Managed MySQL) ---
# [REQUIRED IN PROD] Hostname or IP of the MySQL server
DB_HOST=localhost

# Port of the MySQL server (Aiven typically uses a high port like 12345)
DB_PORT=3306

# [REQUIRED IN PROD] Database name (default 'venuity' locally; Aiven defaults to 'defaultdb')
DB_NAME=venuity

# [REQUIRED IN PROD] Database username (default 'venuity' locally; Aiven defaults to 'avnadmin')
DB_USER=venuity

# [REQUIRED IN PROD] Database password (SECRET - do not commit!)
DB_PASSWORD=replace-with-strong-app-password

# SSL Mode for MySQL connection:
# Options: PREFERRED, REQUIRED, VERIFY_CA, VERIFY_IDENTITY, DISABLED.
# Defaults: 'PREFERRED' in dev/local profile; 'REQUIRED' in 'prod' profile.
DB_SSL_MODE=PREFERRED

# HikariCP Maximum Connection Pool Size.
# Local default: 20. Recommended for free-tier hosting (Render 512MB RAM, Aiven free): 5.
DB_POOL_SIZE=20

# Optional: Full JDBC URL override. If provided, overrides DB_HOST, DB_PORT, DB_NAME, DB_SSL_MODE.
# SPRING_DATASOURCE_URL=jdbc:mysql://host:port/dbname?connectionTimeZone=UTC&sslMode=REQUIRED

# Local Docker Compose root password (used only when launching local MySQL via docker compose)
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_PASSWORD=replace-with-strong-app-password

# --- JWT Authentication (HS256) ---
# [REQUIRED IN PROD] Secret key used to sign JWT tokens.
# MUST be at least 32 bytes (256 bits). NEVER use the dev default in production.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes

# JWT Access token lifespan in minutes (default: 480 minutes / 8 hours)
JWT_ACCESS_MINUTES=480

# JWT Refresh token lifespan in days (default: 7 days)
JWT_REFRESH_DAYS=7

# --- Initial Admin Bootstrap ---
# Creates the bootstrap ADMIN account upon startup if it does not exist.
# In production, if no ADMIN account exists, this MUST be set.
# The password must be at least 12 characters long and cannot be 'admin'.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Set to true to forcibly overwrite credentials of an existing bootstrap admin on startup.
# Defaults to true in dev for convenience, false in prod to preserve user changes.
BOOTSTRAP_ADMIN_FORCE_RESET=true

# --- OpenAPI / Swagger UI ---
# Defaults: enabled (true) in dev; disabled (false) in prod.
# Set to true to inspect API documentation in production if desired.
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false

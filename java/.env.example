MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_PASSWORD=replace-with-strong-app-password

DB_HOST=localhost
DB_PORT=3306
DB_NAME=venuity
DB_USER=venuity
DB_PASSWORD=replace-with-strong-app-password
DB_POOL_SIZE=20

SERVER_PORT=8080

# Required by the server. Use at least 32 random bytes (for example: openssl rand -base64 48).
JWT_SECRET=replace-with-at-least-32-random-bytes

# Optional: creates this ADMIN user on first start if it does not already exist.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
